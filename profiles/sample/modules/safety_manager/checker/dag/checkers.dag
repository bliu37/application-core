# channel freq checker
module_config {
    module_library : "modules/safety_manager/checker/channel_freq_checker/libsafety_channel_freq_checker_component.so"
    components {
        class_name : "ChannelFreqCheckerComponent"
        config {
            name: "safety_channel_freq_checker"
            config_file_path: "/apollo/modules/safety_manager/checker/channel_freq_checker/conf/channel_freq_checker_conf.pb.txt"
            flag_file_path: "/apollo/modules/safety_manager/checker/channel_freq_checker/conf/channel_freq_checker_gflags.conf"
        }
    }
}

# collision checker
module_config {
    module_library : "modules/safety_manager/checker/collision_checker/libsafety_collision_checker_component.so"
    timer_components {
        class_name : "CollisionCheckerComponent"
        config {
            name: "safety_collision_checker"
            interval: 200  # in milliseconds
            config_file_path: "/apollo/modules/safety_manager/checker/collision_checker/conf/collision_checker_conf.pb.txt"
            flag_file_path: "/apollo/modules/safety_manager/checker/collision_checker/conf/collision_checker_gflags.conf"
        }
    }
}

