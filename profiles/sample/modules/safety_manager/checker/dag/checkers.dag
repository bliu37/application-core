# latency checker
module_config {
    module_library : "modules/safety_manager/checker/latency_checker/libsafety_latency_checker_component.so"
    components {
        class_name : "LatencyCheckerComponent"
        config {
            name: "safety_latency_checker"
            config_file_path: "/apollo/modules/safety_manager/checker/latency_checker/conf/latency_checker_conf.pb.txt"
            flag_file_path: "/apollo/modules/safety_manager/checker/latency_checker/conf/latency_checker_gflags.conf"
            readers: [
                {
                    channel: "/apollo/statistics/latency"
                    qos_profile: {
                        depth : 1
                    }
                }
            ]
        }
    }
}

# localization checker
module_config {
    module_library : "modules/safety_manager/checker/localization_checker/libsafety_localization_checker_component.so"
    timer_components {
        class_name : "LocalizationCheckerComponent"
        config {
            name: "safety_localization_checker"
            interval: 200  # in milliseconds
            flag_file_path: "/apollo/modules/safety_manager/checker/localization_checker/conf/localization_checker_gflags.conf"
        }
    }
}

# localization shake checker
module_config {
    module_library : "modules/safety_manager/checker/localization_shake_checker/libsafety_localization_shake_checker_component.so"
    components {
        class_name : "LocalizationShakeCheckerComponent"
        config {
            name: "safety_localization_shake_checker"
            flag_file_path: "/apollo/modules/safety_manager/checker/localization_shake_checker/conf/localization_shake_checker_gflags.conf"
            readers: [
                {
                    channel: "/apollo/localization/pose"
                },
                {
                    channel: "/apollo/canbus/chassis"
                }
            ]
        }
    }
}

